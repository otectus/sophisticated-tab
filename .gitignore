# Gradle
.gradle/
build/
out/
bin/
run/
run-data/

# Eclipse / IntelliJ
*.launch
.classpath
.project
.settings/
.idea/
*.iml
*.iws
*.ipr

# VS Code
.vscode/

# Forge
src/generated/resources/.cache/
forge-*-changelog.txt
# ForgeGradle occasionally drops reobf class outputs in a top-level net/
# directory when a build is interrupted mid-reobf.
/net/

# Local IDE workspace artifacts
*.bak
*.swp

# .tools/ holds local helper scripts and reference artifacts. We commit the
# generator script but exclude the rest (LegendaryTabs atlas copy used as
# input, throwaway investigation scripts, preview PNGs).
.tools/*
!.tools/generate_tab_chrome.py

# Claude Code session artifacts (isolated worktrees, local config).
.claude/

# Stray mod jars accidentally dropped in the repo root (dependencies, test
# fixtures). Build outputs already live under the ignored build/ directory.
/*.jar
